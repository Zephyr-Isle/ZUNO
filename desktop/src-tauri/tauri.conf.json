{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZUNO 管理端",
  "version": "0.1.0",
  "identifier": "com.zuno.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZUNO 壁纸管理端",
        "label": "main",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#F5F4FA"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
