<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 请求加入电池优化白名单（仅用于引导用户；timed 壁纸切换依赖 WorkManager，
         Doze 模式下周期任务会被延迟，白名单能显著降低延迟）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 在线壁纸库：Flutter 管理端直连 zuno-api（HTTPS）。
         Flutter 的 debug/profile 清单会自带这条，release 不会——
         缺了它 installed app 里所有网络请求都会抛 SocketException，
         表现为“目录加载失败”，而且只在 release 包复现。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 壁纸应用必须声明此 feature；required=true 表示无法在没有动态壁纸能力的设备上安装。 -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:label="ZUNO"
        android:name=".ZunoApplication"
        android:icon="@mipmap/launcher_icon"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- HTML 壁纸的 App 内预览 Activity：与壁纸运行时共用同一套 SandboxedWebViewFactory，
             保证“预览看到的就是壁纸渲染的”。不导出（exported=false），仅应用内启动。
             configChanges：旋转/深浅色切换时不要销毁重建（WebView 重载页面既慢又丢状态）。 -->
        <activity
            android:name=".wallpaper.html.HtmlPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
            动态壁纸宿主服务。
            - android:permission="BIND_WALLPAPER"：必须，只有系统才有权绑定该服务。
            - 不设置 android:process：WallpaperService 与主进程同进程运行，
              这样 WorkManager 的 timed 切换可以通过进程内的 ConfigBus 直接通知 Engine 热切换，
              不需要跨进程通信。
        -->
        <service
            android:name=".wallpaper.ZunoWallpaperService"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true"
            android:label="@string/zuno_wallpaper_label">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/zuno_wallpaper" />
        </service>

        <!-- 导出分享：把已安装包打包为 .zuno 后经系统分享面板发出。
             exported=false + grantUriPermissions：仅通过 ACTION_SEND 临时授权读取。
             （备份策略：allowBackup=false——壁纸包是可再导入的便携文件，
             导出/分享即迁移手段；云端备份 72MB 视频会超出配额且无意义。） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.zuno.wallpaper.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 关于页拉起浏览器/QQ 打开群链接（Android 11+ 包可见性要求）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
