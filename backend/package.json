{
  "name": "zuno-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:selfhost": "tsc -p tsconfig.selfhost.json --noEmit",
    "bundle:selfhost": "esbuild selfhost/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=selfhost/dist/server.mjs --loader:.sql=text",
    "db:init:local": "wrangler d1 execute zuno --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute zuno --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.0",
    "wrangler": "^4.164.0"
  }
}
