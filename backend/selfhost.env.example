# zuno-api 自托管配置。使用：
#   cp selfhost.env.example .env
# 填好下面 4 个 secret 后 docker compose up -d。
#
# 生成强随机 secret（每个都要独立生成）：
#   openssl rand -base64 32
# 或者：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---- zuno-api（Worker）所需 ------------------------------------------------

# WebDAV 服务地址。compose 内网固定写这个值（webdav 是服务名）。
WEBDAV_BASE=http://webdav:6065

# Worker 的 WebDAV 只读账号（对应 webdav.yml 里的 zuno-api 用户）。
WEBDAV_USER=zuno-api
WEBDAV_PASS=这里填 WEBDAV_API_PASSWORD 相同的值

# 下载票据签名密钥（HMAC-SHA256），至少 32 字节随机串。泄露 = 任何人可
# 伪造下载链接，仅影响下载票据（不涉及写入）。
TICKET_SECRET=用 openssl rand -base64 32 生成

# 管理接口口令（/api/admin/sync、/api/admin/delete）。泄露 = 任何人可
# 重同步/删除目录元数据，务必用强随机值。
ADMIN_SECRET=用 openssl rand -base64 32 生成

# 自托管没有 Workers 免费版的 10ms CPU 限制，PBKDF2 可以拉满。
PBKDF2_ITERATIONS=100000

# ---- webdav 容器所需（两账号的密码）----------------------------------------

# 桌面管理端上传账号（admin / CRUD）的密码。
WEBDAV_ADMIN_PASSWORD=用 openssl rand -base64 24 生成

# Worker 只读账号（zuno-api / R）的密码。上面 WEBDAV_PASS 要与它相同。
WEBDAV_API_PASSWORD=用 openssl rand -base64 24 生成
